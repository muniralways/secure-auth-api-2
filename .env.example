NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL connection owned by a least-privilege application role.
DATABASE_URL=postgresql://auth_app:replace_me@127.0.0.1:5432/auth_platform
DATABASE_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=auth-platform
JWT_AUDIENCE=auth-platform-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Exactly 32 random bytes encoded as base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

COOKIE_SECURE=false
COOKIE_DOMAIN=

# none means no delivery is attempted. Use SMTP/Mailpit for local email testing.
EMAIL_PROVIDER=none
EMAIL_FROM=Auth Platform <no-reply@example.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Optional social sign-in providers. Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Passkeys / WebAuthn. HTTPS is required outside localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Auth Platform
WEBAUTHN_RP_ORIGIN=http://localhost:5173
MAGIC_LINK_TTL_MINUTES=15
